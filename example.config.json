{
  "proxy": {
    "host": "localhost",
    "port": 8080
  },
  "auth": {
    "default_provider": "auth-service",
    "providers": {
      "auth-service": {
        "type": "jwks",
        "jwks_url": "http://localhost:3000/auth/jwks",
        "refresh_interval": "1h",
        "issuer": "http://localhost:3000/auth/jwks"
      }
    }
  },
  "cors": {
    "allowed_origins": [
      "*"
    ],
    "allowed_methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "PATCH",
      "OPTIONS"
    ],
    "allowed_headers": [
      "Content-Type",
      "Authorization"
    ],
    "exposed_headers": [],
    "allow_credentials": false,
    "max_age": 86400,
    "enabled": false
  },
  "services": [
    {
      "url": "http://localhost:4321",
      "alias": "/data-provider",
      "auth": {
        "enabled": true,
        "provider": ""
      },
      "rate_limit": {
        "requests": 200,
        "window": "1m"
      }
    }
  ]
}
